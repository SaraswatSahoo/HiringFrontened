{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
  
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": "https://hiringbackened.onrender.com/api/v1"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ]
  }
  